{
  "name": "evranger",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "homepage": ".",
  "scripts": {
    "dev": "vite --mode development",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --mode production",
    "design:check": "impeccable detect src/modules/Buyer",
    "test:workspace": "node --test scripts/test-workspace.cjs",
    "test:catalog": "node --test scripts/test-catalog.cjs",
    "test:energy": "node --test scripts/test-energy.cjs",
    "format": "prettier --write src scripts .github *.json *.ts *.js",
    "format:check": "prettier --check src scripts .github *.json *.ts *.js",
    "test": "node --test scripts/test-energy.cjs scripts/test-workspace.cjs scripts/test-catalog.cjs scripts/test-guide.cjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@tanstack/react-query": "^5.108.1",
    "mapbox-gl": "^3.35.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "impeccable": "^4.10.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
